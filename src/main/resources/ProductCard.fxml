<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.ImageView?>
<?import java.net.URL?>

<VBox prefWidth="354" styleClass="auction-card"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.controller.ProductCardController"
      onMouseClicked="#handleCardClick">
    <stylesheets>
        <URL value="@css/styles.css" />
        <URL value="@css/ProductCard.css" />
    </stylesheets>

    <!-- Card Image Area -->
    <StackPane styleClass="card-img-area" prefHeight="160">
        <Label fx:id="lblEmoji" text="📦" styleClass="card-emoji-icon" />
        <ImageView fx:id="imgProduct" fitWidth="354" fitHeight="160" preserveRatio="true" visible="false" />
        <!-- Badge (top-left) -->
        <Label fx:id="lblBadge" text="Đang diễn ra" styleClass="card-badge-running"
               StackPane.alignment="TOP_LEFT">
            <StackPane.margin><Insets top="10" left="10"/></StackPane.margin>
        </Label>
        <!-- Type label (top-right) -->
        <Label fx:id="lblType" text="Điện tử"
               style="-fx-background-color: rgba(0,200,100,0.15); -fx-text-fill: #00c87a; -fx-font-size: 11; -fx-font-weight: bold; -fx-padding: 3 10 3 10; -fx-background-radius: 99;"
               StackPane.alignment="TOP_RIGHT">
            <StackPane.margin><Insets top="10" right="10"/></StackPane.margin>
        </Label>
    </StackPane>

    <!-- Card Body -->
    <VBox spacing="4" style="-fx-padding: 14 16 10 16; -fx-background-color: #0d1a12;">
        <Label fx:id="lblProductName" text="Tên sản phẩm" styleClass="card-name"
               maxWidth="322" wrapText="false"/>
        <Label fx:id="lblSeller" text="Người bán: N/A"
               style="-fx-font-size: 12; -fx-text-fill: #4d8c6a;"/>
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 10 0 0 0;">
            <VBox>
                <Label text="Giá hiện tại" style="-fx-font-size: 11; -fx-text-fill: #4d8c6a;"/>
                <Label fx:id="lblCurrentPrice" text="0 VNĐ" styleClass="card-price" minWidth="-Infinity"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblTimeLeft" text="⏱ 0g 0p" styleClass="card-timer" minWidth="-Infinity"/>
        </HBox>
    </VBox>

    <!-- Card Footer -->
    <HBox alignment="CENTER_LEFT" style="-fx-padding: 10 16 10 16; -fx-border-color: #1a3326; -fx-border-width: 1 0 0 0; -fx-background-color: #0d1a12;">
        <Label fx:id="lblStartPrice" text="Khởi điểm: 0 VNĐ"
               style="-fx-font-size: 12; -fx-text-fill: #4d8c6a;" minWidth="-Infinity"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblBidCount" text="🔨 0 lượt đặt giá"
               style="-fx-font-size: 12; -fx-text-fill: #4d8c6a; -fx-font-weight: 500;" minWidth="-Infinity"/>
    </HBox>
</VBox>
