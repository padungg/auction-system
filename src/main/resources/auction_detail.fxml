<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<ScrollPane fitToWidth="true" style="-fx-background: #f8fafc;"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.client.controller.AuctionDetailController">
    <content>
        <VBox spacing="20" style="-fx-padding: 28;">

            <!-- Breadcrumb -->
            <HBox spacing="6" styleClass="breadcrumb" alignment="CENTER_LEFT">
                <Label text="Trang chủ" onMouseClicked="#goBack" style="-fx-cursor: hand; -fx-text-fill: #94a3b8;"/>
                <Label text="›" styleClass="breadcrumb-sep" style="-fx-text-fill: #94a3b8;"/>
                <Label text="Tất cả sản phẩm" onMouseClicked="#goBack" style="-fx-cursor: hand; -fx-text-fill: #94a3b8;"/>
                <Label text="›" styleClass="breadcrumb-sep" style="-fx-text-fill: #94a3b8;"/>
                <Label fx:id="lblBreadcrumbName" text="..." styleClass="breadcrumb-active"/>
            </HBox>

            <GridPane hgap="24">
                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS" minWidth="500"/>
                    <ColumnConstraints hgrow="NEVER" prefWidth="400"/>
                </columnConstraints>

                <!-- ══ LEFT COLUMN ══ -->
                <VBox spacing="16" GridPane.columnIndex="0">

                    <!-- Product Image Area -->
                    <StackPane styleClass="detail-img" minHeight="260" style="-fx-background-color: linear-gradient(to bottom right, #f1f5f9, #e2e8f0); -fx-background-radius: 16; -fx-border-radius: 16; -fx-border-color: #e2e8f0; -fx-border-width: 1;">
                        <Label fx:id="lblDetailEmoji" text="📦" style="-fx-font-size: 96;"/>
                    </StackPane>

                    <!-- Product Info Card -->
                    <VBox styleClass="section-card" spacing="14">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label fx:id="lblDetailName" text="Đang tải..."
                                   style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblDetailStatus" text="ĐANG DIỄN RA" styleClass="status-running"/>
                        </HBox>

                        <Separator/>

                        <Label text="Thông tin chi tiết"
                               style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 13;"/>
                        <GridPane fx:id="gridSpecs" vgap="12" hgap="30">
                            <!-- Specs dynamically filled by controller -->
                        </GridPane>
                    </VBox>

                    <!-- Description Card -->
                    <VBox styleClass="section-card" spacing="10">
                        <Label text="Mô tả sản phẩm"
                               style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 13;"/>
                        <Label fx:id="lblDetailDesc" text="..." wrapText="true"
                               style="-fx-text-fill: #64748b; -fx-font-size: 13.5; -fx-line-spacing: 5;"/>
                    </VBox>
                </VBox>

                <!-- ══ RIGHT COLUMN (Bid Panel) ══ -->
                <VBox spacing="16" GridPane.columnIndex="1">
                    <VBox styleClass="bid-panel" spacing="16">

                        <!-- Current Price -->
                        <VBox spacing="4">
                            <Label text="GIÁ HIỆN TẠI CAO NHẤT"
                                   style="-fx-text-fill: #94a3b8; -fx-font-size: 11; -fx-font-weight: bold;"/>
                            <Label fx:id="lblCurrentPrice" text="0 VNĐ" styleClass="current-price"/>
                            <Label fx:id="lblStartPrice" text="Giá khởi điểm: 0 VNĐ"
                                   style="-fx-text-fill: #94a3b8; -fx-font-size: 12;"/>
                        </VBox>

                        <!-- Anti-snipe warning -->
                        <HBox fx:id="paneAntiSnipe" alignment="CENTER" styleClass="anti-snipe-warn"
                              visible="false" managed="false">
                            <Label text="⚠️ Cảnh báo Anti-Sniping! Phiên vừa được gia hạn!"/>
                        </HBox>

                        <!-- Countdown -->
                        <VBox styleClass="countdown-box" spacing="8">
                            <Label text="THỜI GIAN CÒN LẠI:"
                                   style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #2563eb; -fx-alignment: center;" maxWidth="1.7976931348623157E308"/>
                            <HBox alignment="CENTER" spacing="8">
                                <VBox alignment="CENTER" spacing="2">
                                    <Label fx:id="lblCdH" text="00" styleClass="countdown-digit"/>
                                    <Label text="Giờ" style="-fx-font-size: 10; -fx-text-fill: #2563eb;"/>
                                </VBox>
                                <Label text=":" styleClass="countdown-colon"/>
                                <VBox alignment="CENTER" spacing="2">
                                    <Label fx:id="lblCdM" text="00" styleClass="countdown-digit"/>
                                    <Label text="Phút" style="-fx-font-size: 10; -fx-text-fill: #2563eb;"/>
                                </VBox>
                                <Label text=":" styleClass="countdown-colon"/>
                                <VBox alignment="CENTER" spacing="2">
                                    <Label fx:id="lblCdS" text="00" styleClass="countdown-digit"/>
                                    <Label text="Giây" style="-fx-font-size: 10; -fx-text-fill: #2563eb;"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Winner Banner (only when finished) -->
                        <VBox fx:id="paneWinner" styleClass="winner-banner" visible="false" managed="false" spacing="4">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="🏆" style="-fx-font-size: 20;"/>
                                <VBox>
                                    <Label text="NGƯỜI CHIẾN THẮNG"
                                           style="-fx-font-size: 11; -fx-font-weight: bold;"/>
                                    <Label fx:id="lblWinnerName" text="..."
                                           style="-fx-font-size: 15; -fx-font-weight: bold;"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Bid Form -->
                        <VBox fx:id="paneBidForm" spacing="10">
                            <Label fx:id="lblBidStep" text="Bước giá tối thiểu: 500.000 VNĐ"
                                   style="-fx-font-size: 11.5; -fx-text-fill: #94a3b8;"/>
                            <HBox spacing="8">
                                <TextField fx:id="txtBidAmount" promptText="Nhập số tiền..."
                                           styleClass="form-input" HBox.hgrow="ALWAYS"/>
                                <Button text="ĐẶT GIÁ" styleClass="btn-primary" onAction="#handlePlaceBid"/>
                            </HBox>
                            <Label text="Giá của bạn phải cao hơn giá hiện tại"
                                   style="-fx-font-size: 10.5; -fx-text-fill: #94a3b8;"/>
                        </VBox>

                        <!-- Auto-bid Section -->
                        <VBox styleClass="auto-bid-section" spacing="10">
                            <Label text="⚡ Auto-Bid — Tự động phản giá"
                                   style="-fx-font-weight: bold; -fx-text-fill: #d97706; -fx-font-size: 13;"/>

                            <!-- Status (when registered) -->
                            <VBox fx:id="paneAutoBidStatus"
                                  style="-fx-padding: 10; -fx-background-radius: 8; -fx-border-color: #fcd34d; -fx-border-radius: 8;"
                                  visible="false" managed="false">
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="⚡ Đang hoạt động"
                                           style="-fx-font-weight: bold; -fx-font-size: 12;"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button text="Hủy"
                                            style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-size: 11; -fx-padding: 2 8; -fx-cursor: hand; -fx-background-radius: 6;"
                                            onAction="#handleCancelAutoBid"/>
                                </HBox>
                                <Label fx:id="lblAutoBidDetail" text="Max: 0đ | Inc: 0đ"
                                       style="-fx-font-size: 11.5; -fx-text-fill: #64748b; -fx-padding: 4 0 0 0;"/>
                            </VBox>

                            <!-- Form (default) -->
                            <VBox fx:id="paneAutoBidForm" spacing="8">
                                <HBox spacing="8">
                                    <TextField fx:id="txtAutoMax" promptText="Giá tối đa (maxBid)"
                                               styleClass="form-input" HBox.hgrow="ALWAYS"/>
                                    <TextField fx:id="txtAutoInc" promptText="Bước tăng"
                                               styleClass="form-input" prefWidth="110"/>
                                </HBox>
                                <Button text="⚡ Đăng ký Auto-Bid" styleClass="auto-bid-btn"
                                        maxWidth="1.7976931348623157E308" onAction="#handleRegisterAutoBid"/>
                            </VBox>
                        </VBox>

                        <!-- Bid History with Chart -->
                        <VBox spacing="10">
                            <Label text="📋 Lịch sử đấu giá (Real-time)"
                                   style="-fx-font-weight: bold; -fx-font-size: 13; -fx-text-fill: #1e293b;"/>

                            <!-- Line Chart -->
                            <LineChart fx:id="bidChart" prefHeight="200"
                                       style="-fx-background-color: transparent; -fx-padding: 0;">
                                <xAxis>
                                    <CategoryAxis fx:id="chartXAxis" label=""
                                                  style="-fx-tick-label-font-size: 9px;"/>
                                </xAxis>
                                <yAxis>
                                    <NumberAxis fx:id="chartYAxis" label=""
                                                style="-fx-tick-label-font-size: 9px;"/>
                                </yAxis>
                            </LineChart>

                            <!-- Bid History Table -->
                            <TableView fx:id="tableHistory" prefHeight="220" styleClass="bid-history-table">
                                <columns>
                                    <TableColumn fx:id="colUser" text="Người dùng" prefWidth="130"/>
                                    <TableColumn fx:id="colAmount" text="Giá đặt" prefWidth="120"/>
                                    <TableColumn fx:id="colTime" text="Thời gian" prefWidth="110"/>
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                            </TableView>
                        </VBox>

                    </VBox>
                </VBox>
            </GridPane>
        </VBox>
    </content>
</ScrollPane>

