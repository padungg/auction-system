<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="0" style="-fx-padding: 24; -fx-background-color: #080f0a;"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.controller.PaymentController"
      stylesheets="@css/Payment.css">

    <!-- Breadcrumb -->
    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="breadcrumb" style="-fx-padding: 0 0 16 0;">
        <Label text="Trang ch&#7911;" style="-fx-text-fill: #2d6648;"/>
        <Label text="&#8250;" styleClass="breadcrumb-sep"/>
        <Label text="Thanh to&#225;n" style="-fx-text-fill: #a7f3d0; -fx-font-weight: bold;"/>
    </HBox>

    <!-- Tabs -->
    <HBox spacing="0" style="-fx-border-color: transparent transparent #1a3326 transparent; -fx-border-width: 2; -fx-background-color: #080f0a;">
        <Button fx:id="btnTabPending" text="&#128179; Ch&#7901; thanh to&#225;n" onAction="#switchTabPending"
                style="-fx-background-color: transparent; -fx-text-fill: #00c87a; -fx-font-weight: bold; -fx-font-size: 13.5; -fx-padding: 10 22; -fx-border-color: transparent transparent #00c87a transparent; -fx-border-width: 0 0 2 0; -fx-cursor: hand;"/>
        <Button fx:id="btnTabHistory" text="&#128203; L&#7883;ch s&#7917; thanh to&#225;n" onAction="#switchTabHistory"
                style="-fx-background-color: transparent; -fx-text-fill: #4d8c6a; -fx-font-weight: bold; -fx-font-size: 13.5; -fx-padding: 10 22; -fx-cursor: hand;"/>
    </HBox>

    <!-- Pending Panel — Card List -->
    <VBox fx:id="panelPending" VBox.vgrow="ALWAYS" spacing="12" style="-fx-padding: 20 0 0 0; -fx-background-color: #080f0a;">
        <ScrollPane fx:id="scrollPending" fitToWidth="true" VBox.vgrow="ALWAYS"
                    style="-fx-background-color: #080f0a; -fx-background: #080f0a; -fx-border-color: transparent;">
            <VBox fx:id="cardContainer" spacing="12" style="-fx-background-color: #080f0a;"/>
        </ScrollPane>
        <Label fx:id="lblNoPending" text="&#9989; Kh&#244;ng c&#243; phi&#234;n n&#224;o ch&#7901; thanh to&#225;n."
               managed="false" visible="false"
               style="-fx-text-fill: #4d8c6a; -fx-font-size: 14; -fx-padding: 32; -fx-alignment: center;"/>
    </VBox>

    <!-- History Panel — Table + Pagination -->
    <VBox fx:id="panelHistory" VBox.vgrow="ALWAYS" spacing="12" visible="false" managed="false"
          style="-fx-padding: 20 0 0 0; -fx-background-color: #080f0a;">
        <TableView fx:id="tableHistory" styleClass="data-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colHistName" text="S&#7843;n ph&#7849;m" prefWidth="280"/>
                <TableColumn fx:id="colHistPrice" text="Gi&#225; &#273;&#227; thanh to&#225;n" prefWidth="160"/>
                <TableColumn fx:id="colHistTime" text="K&#7871;t th&#250;c l&#250;c" prefWidth="150"/>
                <TableColumn fx:id="colHistStatus" text="Tr&#7841;ng th&#225;i" prefWidth="120"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>

        <!-- Pagination row -->
        <HBox alignment="CENTER" spacing="10" style="-fx-padding: 6 0 2 0;">
            <Button fx:id="histBtnFirst" text="&#171;" onAction="#histGoFirst"
                    style="-fx-background-color: #0f2218; -fx-text-fill: #5a9e7a; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 5 10; -fx-font-weight: bold;"/>
            <Button fx:id="histBtnPrev" text="&#8249;" onAction="#histGoPrev"
                    style="-fx-background-color: #0f2218; -fx-text-fill: #5a9e7a; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 5 10; -fx-font-size: 15; -fx-font-weight: bold;"/>
            <HBox fx:id="histPageBox" spacing="5" alignment="CENTER"/>
            <Button fx:id="histBtnNext" text="&#8250;" onAction="#histGoNext"
                    style="-fx-background-color: #0f2218; -fx-text-fill: #5a9e7a; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 5 10; -fx-font-size: 15; -fx-font-weight: bold;"/>
            <Button fx:id="histBtnLast" text="&#187;" onAction="#histGoLast"
                    style="-fx-background-color: #0f2218; -fx-text-fill: #5a9e7a; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 5 10; -fx-font-weight: bold;"/>
            <Label fx:id="histPageInfo" text="Trang 1 / 1"
                   style="-fx-text-fill: #4d8c6a; -fx-font-size: 12px; -fx-padding: 0 0 0 6;"/>
        </HBox>
    </VBox>

</VBox>
