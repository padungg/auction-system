<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import java.net.URL?>

<!--
    UET Auction — Login Screen  (Dark Premium Glassmorphism Redesign)
    Layout: StackPane root → dark gradient backdrop + centered glass card
-->
<StackPane prefWidth="1100.0" prefHeight="700.0"
           xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.auction.client.controller.LoginController"
           styleClass="login-root">

    <stylesheets>
        <URL value="@css/Login.css" />
    </stylesheets>

    <!-- ═══════════════════════════════════════════════════════
         DECORATIVE BACKGROUND CIRCLES (blurred orbs)
         ═══════════════════════════════════════════════════════ -->
    <Circle styleClass="orb-1" radius="280" StackPane.alignment="TOP_LEFT"
            translateX="-80" translateY="-60"/>
    <Circle styleClass="orb-2" radius="220" StackPane.alignment="BOTTOM_RIGHT"
            translateX="60" translateY="80"/>
    <Circle styleClass="orb-3" radius="140" StackPane.alignment="CENTER_RIGHT"
            translateX="160" translateY="-120"/>

    <!-- ═══════════════════════════════════════════════════════
         MAIN CONTENT — two-column HBox centred on screen
         ═══════════════════════════════════════════════════════ -->
    <HBox alignment="CENTER" spacing="0" maxWidth="960" maxHeight="620"
          StackPane.alignment="CENTER">

        <!-- ─── LEFT: GLASS FORM PANEL ─── -->
        <VBox styleClass="glass-card" alignment="TOP_LEFT" spacing="0"
              prefWidth="430" minWidth="380">

            <!-- Brand badge -->
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="brand-badge">
                <Label text="⬡" styleClass="brand-hex"/>
                <Label text="UET Auction" styleClass="brand-name"/>
            </HBox>

            <!-- Dynamic title area -->
            <Label fx:id="lblTitle" text="Chào mừng trở lại"
                   styleClass="form-heading" wrapText="true"/>
            <Label fx:id="lblSubtitle" text="Đăng nhập để tham gia đấu giá ngay hôm nay"
                   styleClass="form-subheading" wrapText="true"/>

            <!-- Tab switcher -->
            <HBox styleClass="tab-row" spacing="0">
                <Button fx:id="tabLogin" text="Đăng nhập" onAction="#switchToLoginTab"
                        styleClass="tab-btn-active" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button fx:id="tabRegister" text="Đăng ký" onAction="#switchToRegisterTab"
                        styleClass="tab-btn" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>

            <!-- ── LOGIN FORM ── -->
            <VBox fx:id="loginForm" spacing="14" styleClass="fields-area">
                <VBox spacing="5">
                    <Label text="Tên đăng nhập" styleClass="field-label"/>
                    <TextField fx:id="loginUsername" promptText="Nhập tên đăng nhập..."
                               styleClass="dark-input"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="Mật khẩu" styleClass="field-label"/>
                    <PasswordField fx:id="loginPassword" promptText="Nhập mật khẩu..."
                                  styleClass="dark-input"/>
                </VBox>

                <Label fx:id="loginMessage" text="" styleClass="msg-error" wrapText="true"/>

                <Button text="ĐĂNG NHẬP  →" onAction="#handleLogin"
                        maxWidth="Infinity" styleClass="primary-btn"/>

                <HBox alignment="CENTER" spacing="6">
                    <Label text="Chưa có tài khoản?" styleClass="hint-text"/>
                    <Label text="Đăng ký ngay" onMouseClicked="#switchToRegisterTab"
                           styleClass="link-text"/>
                </HBox>
            </VBox>

            <!-- ── REGISTER FORM ── -->
            <ScrollPane fx:id="registerScrollPane" fitToWidth="true" hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED" styleClass="reg-scroll"
                        visible="false" managed="false">
                <VBox fx:id="registerForm" spacing="11" styleClass="fields-area-reg">
                    <HBox spacing="10">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Họ và tên *" styleClass="field-label"/>
                            <TextField fx:id="regFullName" promptText="Nguyễn Văn A"
                                       styleClass="dark-input"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Email *" styleClass="field-label"/>
                            <TextField fx:id="regEmail" promptText="email@example.com"
                                       styleClass="dark-input"/>
                        </VBox>
                    </HBox>
                    <HBox spacing="10">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Tên đăng nhập *" styleClass="field-label"/>
                            <TextField fx:id="regUsername" promptText="username"
                                       styleClass="dark-input"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Số điện thoại" styleClass="field-label"/>
                            <TextField fx:id="regPhone" promptText="0123456789"
                                       styleClass="dark-input"/>
                        </VBox>
                    </HBox>
                    <HBox spacing="10">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Địa chỉ" styleClass="field-label"/>
                            <TextField fx:id="regAddress" promptText="Số nhà, đường, quận..."
                                       styleClass="dark-input"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Tên cửa hàng (nếu bán)" styleClass="field-label"/>
                            <TextField fx:id="regStoreName" promptText="Tên shop..."
                                       styleClass="dark-input"/>
                        </VBox>
                    </HBox>
                    <HBox spacing="10">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Mật khẩu *" styleClass="field-label"/>
                            <PasswordField fx:id="regPassword" promptText="Mật khẩu..."
                                          styleClass="dark-input"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Xác nhận mật khẩu *" styleClass="field-label"/>
                            <PasswordField fx:id="regConfirm" promptText="Nhập lại..."
                                          styleClass="dark-input"/>
                        </VBox>
                    </HBox>

                    <Label fx:id="regMessage" text="" styleClass="msg-error" wrapText="true"/>

                    <Button text="TẠO TÀI KHOẢN  →" onAction="#handleRegister"
                            maxWidth="Infinity" styleClass="primary-btn"/>

                    <HBox alignment="CENTER" spacing="6">
                        <Label text="Đã có tài khoản?" styleClass="hint-text"/>
                        <Label text="Đăng nhập ngay" onMouseClicked="#switchToLoginTab"
                               styleClass="link-text"/>
                    </HBox>
                </VBox>
            </ScrollPane>

        </VBox>
        <!-- end glass-card -->

        <!-- ─── RIGHT: INFO PANEL ─── -->
        <VBox styleClass="info-panel" alignment="CENTER_LEFT" spacing="28"
              prefWidth="470" minWidth="400">

            <!-- Headline -->
            <VBox spacing="10">
                <Label text="Nền tảng đấu giá" styleClass="info-eyebrow"/>
                <Label text="Mua – Bán – Thắng" styleClass="info-title" wrapText="true"/>
                <Label text="trực tuyến thông minh" styleClass="info-title-accent" wrapText="true"/>
                <Label text="Hệ thống đấu giá thời gian thực, an toàn và minh bạch\ndành riêng cho cộng đồng UET."
                       styleClass="info-desc" wrapText="true"/>
            </VBox>

            <!-- Feature list -->
            <VBox spacing="14">
                <HBox alignment="CENTER_LEFT" spacing="14">
                    <Label text="⚡" styleClass="feat-icon"/>
                    <VBox spacing="1">
                        <Label text="Đấu giá thời gian thực" styleClass="feat-title"/>
                        <Label text="Cập nhật giá tức thì, không độ trễ" styleClass="feat-desc"/>
                    </VBox>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="14">
                    <Label text="🤖" styleClass="feat-icon"/>
                    <VBox spacing="1">
                        <Label text="Tự động đặt giá thông minh" styleClass="feat-title"/>
                        <Label text="Hệ thống Auto-bid bảo vệ bạn 24/7" styleClass="feat-desc"/>
                    </VBox>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="14">
                    <Label text="🔒" styleClass="feat-icon"/>
                    <VBox spacing="1">
                        <Label text="Bảo mật &amp; minh bạch tuyệt đối" styleClass="feat-title"/>
                        <Label text="Giao dịch được mã hóa end-to-end" styleClass="feat-desc"/>
                    </VBox>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="14">
                    <Label text="💰" styleClass="feat-icon"/>
                    <VBox spacing="1">
                        <Label text="Thanh toán nhanh chóng" styleClass="feat-title"/>
                        <Label text="Ví điện tử tích hợp, rút tiền dễ dàng" styleClass="feat-desc"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Stats row -->
            <HBox spacing="28" styleClass="stats-row">
                <VBox alignment="CENTER" spacing="2">
                    <Label text="10K+" styleClass="stat-num"/>
                    <Label text="Người dùng" styleClass="stat-label"/>
                </VBox>
                <Label text="|" styleClass="stat-divider"/>
                <VBox alignment="CENTER" spacing="2">
                    <Label text="50K+" styleClass="stat-num"/>
                    <Label text="Phiên đấu giá" styleClass="stat-label"/>
                </VBox>
                <Label text="|" styleClass="stat-divider"/>
                <VBox alignment="CENTER" spacing="2">
                    <Label text="99.9%" styleClass="stat-num"/>
                    <Label text="Uptime" styleClass="stat-label"/>
                </VBox>
            </HBox>

            <!-- Footer -->
            <Label text="© 2025 UET Auction · CS2043 · Nhóm 10"
                   styleClass="info-footer"/>
        </VBox>

    </HBox>
    <!-- end main HBox -->

</StackPane>
