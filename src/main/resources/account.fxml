<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="14" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.controller.AccountController">

    <!-- Breadcrumb -->
    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="breadcrumb">
        <Label text="Trang ch&#7911;" style="-fx-text-fill: #64748b;"/>
        <Label text="&#8250;" styleClass="breadcrumb-sep"/>
        <Label text="T&#224;i kho&#7843;n c&#7911;a t&#244;i" style="-fx-text-fill: #1e293b; -fx-font-weight: bold;"/>
    </HBox>

    <!-- PROFILE CARD — 2 columns -->
    <HBox spacing="0" styleClass="section-card" style="-fx-padding: 0;">

        <!-- LEFT: Avatar + Info (60%) -->
        <HBox spacing="16" style="-fx-padding: 20 16 20 20;" HBox.hgrow="ALWAYS" alignment="TOP_LEFT">

            <!-- Avatar -->
            <VBox alignment="CENTER" minWidth="64" maxWidth="64" minHeight="64" maxHeight="64"
                  style="-fx-background-color: #2563eb; -fx-background-radius: 50%;">
                <Label fx:id="lblAvatar" text="?" style="-fx-text-fill: white; -fx-font-size: 26; -fx-font-weight: bold;"/>
            </VBox>

            <!-- Text info -->
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label fx:id="lblName" text="..."
                       style="-fx-font-size: 17; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label fx:id="lblUsername" text="..." style="-fx-text-fill: #64748b; -fx-font-size: 12;"/>
                    <Label fx:id="lblEmail"    text="..." style="-fx-text-fill: #64748b; -fx-font-size: 12;"/>
                </HBox>
                <Label fx:id="lblRole"
                       style="-fx-font-weight: bold; -fx-text-fill: #2563eb; -fx-font-size: 12; -fx-padding: 1 0 3 0;"/>

                <HBox spacing="6" alignment="CENTER_LEFT">
                    <Label text="&#128222;" style="-fx-font-size: 12;"/>
                    <Label fx:id="lblPhone" text="..." style="-fx-text-fill: #475569; -fx-font-size: 13;"/>
                </HBox>
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <Label text="&#127968;" style="-fx-font-size: 12;"/>
                    <Label fx:id="lblAddress" text="..." style="-fx-text-fill: #475569; -fx-font-size: 13;"/>
                </HBox>
                <HBox fx:id="boxStore" spacing="6" alignment="CENTER_LEFT" managed="false" visible="false">
                    <Label text="&#127978;" style="-fx-font-size: 12;"/>
                    <Label fx:id="lblStore" text="..." style="-fx-text-fill: #475569; -fx-font-size: 13;"/>
                </HBox>
                <HBox spacing="4" alignment="CENTER_LEFT">
                    <Label text="&#11088;" style="-fx-font-size: 12;"/>
                    <Label text="Uy t&#237;n: " style="-fx-font-size: 12; -fx-text-fill: #64748b;"/>
                    <Label fx:id="lblRating" text="0.0" style="-fx-text-fill: #f59e0b; -fx-font-weight: bold; -fx-font-size: 13;"/>
                    <Label text="/5.0" style="-fx-font-size: 12; -fx-text-fill: #94a3b8;"/>
                </HBox>
            </VBox>
        </HBox>

        <!-- Vertical divider -->
        <Separator orientation="VERTICAL"/>

        <!-- RIGHT: Balance + Actions (40%) -->
        <VBox spacing="10" style="-fx-padding: 20 20 20 20;" alignment="TOP_LEFT" minWidth="260" maxWidth="300">
            <Label text="S&#7889; d&#432; t&#224;i kho&#7843;n" style="-fx-text-fill: #64748b; -fx-font-size: 12;"/>
            <Label fx:id="lblBalance" text="0 VND"
                   style="-fx-font-size: 22; -fx-font-weight: 800; -fx-text-fill: #10b981;"/>

            <Separator/>

            <!-- Amount input -->
            <TextField fx:id="txtAmount" promptText="Nh&#7853;p s&#7889; ti&#7873;n..." styleClass="form-input"
                       maxWidth="Infinity"/>

            <!-- Deposit / Withdraw buttons -->
            <HBox spacing="8">
                <Button text="&#128184; R&#250;t ti&#7873;n" onAction="#handleWithdraw" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                        style="-fx-text-fill: #475569; -fx-border-color: #cbd5e1; -fx-border-radius: 7;
                               -fx-background-radius: 7; -fx-cursor: hand; -fx-padding: 7 0; -fx-font-size: 12;"/>
                <Button text="&#128176; N&#7841;p ti&#7873;n" onAction="#handleDeposit" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                        style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold;
                               -fx-border-radius: 7; -fx-background-radius: 7; -fx-cursor: hand;
                               -fx-padding: 7 0; -fx-font-size: 12;"/>
            </HBox>

            <!-- Edit profile button -->
            <Button text="&#9998; Ch&#7881;nh s&#7917;a h&#7891; s&#417;" onAction="#handleEditProfile"
                    maxWidth="Infinity"
                    style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-font-size: 12;
                           -fx-border-radius: 7; -fx-background-radius: 7; -fx-cursor: hand; -fx-padding: 7 0;"/>
        </VBox>
    </HBox>

    <!-- BID HISTORY -->
    <VBox spacing="10" styleClass="section-card" VBox.vgrow="ALWAYS">
        <Label text="L&#7883;ch s&#7917; &#273;&#7863;t gi&#225; c&#7911;a t&#244;i"
               style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>

        <TableView fx:id="tableHistory" VBox.vgrow="ALWAYS" styleClass="data-table">
            <columns>
                <TableColumn fx:id="colAuctionId" text="Phi&#234;n"         prefWidth="100"/>
                <TableColumn fx:id="colItemName"  text="S&#7843;n ph&#7849;m"    prefWidth="260"/>
                <TableColumn fx:id="colPrice"     text="Gi&#225; &#273;&#7863;t"      prefWidth="150"/>
                <TableColumn fx:id="colTime"      text="Th&#7901;i gian"     prefWidth="150"/>
                <TableColumn fx:id="colResult"    text="K&#7871;t qu&#7843;"    prefWidth="110"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>

        <!-- Pagination -->
        <HBox alignment="CENTER" spacing="8">
            <Button fx:id="histBtnFirst" text="&#171;" onAction="#histGoFirst"
                    style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 5 10; -fx-font-weight: bold;"/>
            <Button fx:id="histBtnPrev" text="&#8249;" onAction="#histGoPrev"
                    style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 5 10; -fx-font-size: 15; -fx-font-weight: bold;"/>
            <HBox fx:id="histPageBox" spacing="5" alignment="CENTER"/>
            <Button fx:id="histBtnNext" text="&#8250;" onAction="#histGoNext"
                    style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 5 10; -fx-font-size: 15; -fx-font-weight: bold;"/>
            <Button fx:id="histBtnLast" text="&#187;" onAction="#histGoLast"
                    style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 5 10; -fx-font-weight: bold;"/>
            <Label fx:id="histPageInfo" text="Trang 1 / 1"
                   style="-fx-text-fill: #64748b; -fx-font-size: 12px; -fx-padding: 0 0 0 6;"/>
        </HBox>
    </VBox>
</VBox>
