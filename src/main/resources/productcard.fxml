<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefWidth="354" styleClass="auction-card"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.controller.ProductcardController"
      stylesheets="@styles.css"
      onMouseClicked="#handleCardClick">

    <!-- Card Image Area -->
    <StackPane styleClass="card-img-area" prefHeight="160">
        <Label fx:id="lblEmoji" text="📦" styleClass="card-emoji-icon" />
        <!-- Badge (top-left) -->
        <Label fx:id="lblBadge" text="Đang diễn ra" styleClass="card-badge-running"
               StackPane.alignment="TOP_LEFT">
            <StackPane.margin><Insets top="10" left="10"/></StackPane.margin>
        </Label>
        <!-- Type label (top-right) -->
        <Label fx:id="lblType" text="Điện tử"
               style="-fx-background-color: rgba(255,255,255,0.9); -fx-text-fill: #475569; -fx-font-size: 11; -fx-font-weight: bold; -fx-padding: 3 10 3 10; -fx-background-radius: 99;"
               StackPane.alignment="TOP_RIGHT">
            <StackPane.margin><Insets top="10" right="10"/></StackPane.margin>
        </Label>
    </StackPane>

    <!-- Card Body -->
    <VBox spacing="4" style="-fx-padding: 14 16 10 16;">
        <Label fx:id="lblProductName" text="Tên sản phẩm" styleClass="card-name"
               maxWidth="322" wrapText="false"/>
        <Label fx:id="lblSeller" text="Người bán: N/A"
               style="-fx-font-size: 12; -fx-text-fill: #94a3b8;"/>
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 10 0 0 0;">
            <VBox>
                <Label text="Giá hiện tại" style="-fx-font-size: 11; -fx-text-fill: #94a3b8;"/>
                <Label fx:id="lblCurrentPrice" text="0 VNĐ" styleClass="card-price" minWidth="-Infinity"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblTimeLeft" text="⏱ 0g 0p" styleClass="card-timer" minWidth="-Infinity"/>
        </HBox>
    </VBox>

    <!-- Card Footer -->
    <HBox alignment="CENTER_LEFT" style="-fx-padding: 10 16 10 16; -fx-border-color: #f1f5f9; -fx-border-width: 1 0 0 0;">
        <Label fx:id="lblStartPrice" text="Khởi điểm: 0 VNĐ"
               style="-fx-font-size: 12; -fx-text-fill: #94a3b8;" minWidth="-Infinity"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblBidCount" text="🔨 0 lượt bid"
               style="-fx-font-size: 12; -fx-text-fill: #64748b; -fx-font-weight: 500;" minWidth="-Infinity"/>
    </HBox>
</VBox>
