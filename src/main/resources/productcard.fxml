<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="350.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="bank.app.ProductCardController">
    <children>
        <ImageView fx:id="imgProduct" fitHeight="200.0" fitWidth="350.0" pickOnBounds="true" preserveRatio="false" style="-fx-border-radius: 15 15 0 0;" />

        <VBox spacing="10.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label fx:id="lblProductName" text="Tên sản phẩm" wrapText="true" HBox.hgrow="ALWAYS">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblStatus" style="-fx-background-color: #dcfce7; -fx-text-fill: #166534; -fx-padding: 5 10; -fx-background-radius: 12;" text="🟢 Đang diễn ra">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>

                <Label fx:id="lblStartPrice" text="Giá khởi điểm: 0 đ" textFill="#6b7280" />

                <HBox alignment="BASELINE_LEFT" spacing="10.0">
                    <children>
                        <Label text="Giá cao nhất:" textFill="#6b7280" />
                        <Label fx:id="lblCurrentPrice" text="0 đ" textFill="#ef4444">
                            <font>
                                <Font name="System Bold" size="20.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>

                <Label fx:id="lblTimeLeft" text="Kết thúc trong: --:--:--" textFill="#2563eb">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>

                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" text="Tham gia ngay">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                    <padding>
                        <Insets bottom="10.0" top="10.0" />
                    </padding>
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </Button>
            </children>
        </VBox>
    </children>
</VBox>