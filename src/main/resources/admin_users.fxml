<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" style="-fx-padding: 24;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.controller.AdminController">

    <!-- Breadcrumb -->
    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="breadcrumb">
        <Label text="Trang ch&#7911;" style="-fx-text-fill: #64748b;"/>
        <Label text="&#8250;" styleClass="breadcrumb-sep"/>
        <Label text="Qu&#7843;n tr&#7883;" style="-fx-text-fill: #64748b;"/>
        <Label text="&#8250;" styleClass="breadcrumb-sep"/>
        <Label text="Qu&#7843;n l&#253; ng&#432;&#7901;i d&#249;ng" style="-fx-text-fill: #1e293b; -fx-font-weight: bold;"/>
    </HBox>

    <!-- STAT CARDS -->
    <HBox spacing="16">
        <!-- Tong dang ky -->
        <VBox HBox.hgrow="ALWAYS" spacing="4" alignment="CENTER_LEFT"
              style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 14; -fx-background-radius: 14; -fx-padding: 20 24; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 6, 0, 0, 2);">
            <Label text="&#128101; T&#7893;ng &#273;&#259;ng k&#253;" style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
            <Label fx:id="statTotalUsers" text="0"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2563eb;"/>
            <Label text="t&#224;i kho&#7843;n" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px;"/>
        </VBox>
        <!-- Dang hoat dong -->
        <VBox HBox.hgrow="ALWAYS" spacing="4" alignment="CENTER_LEFT"
              style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 14; -fx-background-radius: 14; -fx-padding: 20 24; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 6, 0, 0, 2);">
            <Label text="&#9989; &#272;ang ho&#7841;t &#273;&#7897;ng" style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
            <Label fx:id="statActiveUsers" text="0"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #059669;"/>
            <Label text="t&#224;i kho&#7843;n" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px;"/>
        </VBox>
        <!-- Bi khoa -->
        <VBox HBox.hgrow="ALWAYS" spacing="4" alignment="CENTER_LEFT"
              style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 14; -fx-background-radius: 14; -fx-padding: 20 24; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 6, 0, 0, 2);">
            <Label text="&#128274; B&#7883; kh&#243;a" style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
            <Label fx:id="statLockedUsers" text="0"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #dc2626;"/>
            <Label text="t&#224;i kho&#7843;n" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px;"/>
        </VBox>
        <!-- Admin -->
        <VBox HBox.hgrow="ALWAYS" spacing="4" alignment="CENTER_LEFT"
              style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 14; -fx-background-radius: 14; -fx-padding: 20 24; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 6, 0, 0, 2);">
            <Label text="&#128081; Qu&#7843;n tr&#7883; vi&#234;n" style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
            <Label fx:id="statAdminUsers" text="0"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #7c3aed;"/>
            <Label text="t&#224;i kho&#7843;n" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px;"/>
        </VBox>
    </HBox>

    <!-- TABLE CARD -->
    <VBox styleClass="section-card" VBox.vgrow="ALWAYS" spacing="16">
        <!-- Header row -->
        <HBox alignment="CENTER_LEFT">
            <Label text="Danh s&#225;ch ng&#432;&#7901;i d&#249;ng" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="8">
                <Button text="&#128274; Kh&#243;a t&#224;i kho&#7843;n" onAction="#handleLockUser" styleClass="btn"
                        style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 8 16;"/>
                <Button text="&#128275; M&#7903; kh&#243;a" onAction="#handleUnlockUser" styleClass="btn"
                        style="-fx-background-color: #22c55e; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 8 16;"/>
            </HBox>
        </HBox>

        <!-- Table -->
        <TableView fx:id="tableUsers" styleClass="data-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colSelect" prefWidth="40" sortable="false"/>
                <TableColumn fx:id="colUserId" text="ID" prefWidth="60"/>
                <TableColumn fx:id="colUserUsername" text="T&#234;n &#273;&#259;ng nh&#7853;p" prefWidth="140"/>
                <TableColumn fx:id="colUserFullName" text="H&#7885; t&#234;n" prefWidth="160"/>
                <TableColumn fx:id="colUserEmail" text="Email" prefWidth="190"/>
                <TableColumn fx:id="colUserRole" text="Vai tr&#242;" prefWidth="100"/>
                <TableColumn fx:id="colUserBalance" text="S&#7889; d&#432;" prefWidth="130"/>
                <TableColumn fx:id="colUserStatus" text="Tr&#7841;ng th&#225;i" prefWidth="110"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>

        <!-- PAGINATION ROW -->
        <HBox alignment="CENTER" spacing="12" style="-fx-padding: 8 0 4 0;">
            <Button fx:id="btnFirstPage" text="&#171;" onAction="#goFirstPage"
                    style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 6 12; -fx-font-weight: bold;"/>
            <Button fx:id="btnPrevPage" text="&#8249;" onAction="#goPrevPage"
                    style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 6 12; -fx-font-size: 16; -fx-font-weight: bold;"/>

            <HBox fx:id="pageButtonBox" spacing="6" alignment="CENTER"/>

            <Button fx:id="btnNextPage" text="&#8250;" onAction="#goNextPage"
                    style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 6 12; -fx-font-size: 16; -fx-font-weight: bold;"/>
            <Button fx:id="btnLastPage" text="&#187;" onAction="#goLastPage"
                    style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 6 12; -fx-font-weight: bold;"/>

            <Label fx:id="lblPageInfo" text="Trang 1 / 1"
                   style="-fx-text-fill: #64748b; -fx-font-size: 12px; -fx-padding: 0 0 0 8;"/>
        </HBox>
    </VBox>
</VBox>
