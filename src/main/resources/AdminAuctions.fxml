<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" style="-fx-padding: 24; -fx-background-color: #080f0a;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.controller.AdminController"
      stylesheets="@css/Admin.css">

    <!-- Breadcrumb -->
    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="breadcrumb">
        <Label text="Trang ch&#7911;" style="-fx-text-fill: #64748b;"/>
        <Label text="&#8250;" styleClass="breadcrumb-sep"/>
        <Label text="Qu&#7843;n tr&#7883;" style="-fx-text-fill: #64748b;"/>
        <Label text="&#8250;" styleClass="breadcrumb-sep"/>
        <Label text="Qu&#7843;n l&#253; &#273;&#7845;u gi&#225;" style="-fx-text-fill: #1e293b; -fx-font-weight: bold;"/>
    </HBox>

    <!-- STAT CARDS -->
    <HBox spacing="12">
        <!-- Tong phien -->
        <VBox HBox.hgrow="ALWAYS" spacing="4" alignment="CENTER_LEFT"
              style="-fx-background-color: #0d1a12; -fx-border-color: #1a3326; -fx-border-radius: 14; -fx-background-radius: 14; -fx-padding: 16 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.35), 6, 0, 0, 2);">
            <Label text="&#128230; T&#7893;ng phi&#234;n" style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
            <Label fx:id="aucStatTotal" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2563eb;"/>
        </VBox>
        <!-- RUNNING -->
        <VBox HBox.hgrow="ALWAYS" spacing="4" alignment="CENTER_LEFT"
              style="-fx-background-color: #0d1a12; -fx-border-color: #1a3326; -fx-border-radius: 14; -fx-background-radius: 14; -fx-padding: 16 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.35), 6, 0, 0, 2);">
            <Label text="&#9654; &#272;ang di&#7877;n ra" style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
            <Label fx:id="aucStatRunning" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #16a34a;"/>
        </VBox>
        <!-- OPEN -->
        <VBox HBox.hgrow="ALWAYS" spacing="4" alignment="CENTER_LEFT"
              style="-fx-background-color: #0d1a12; -fx-border-color: #1a3326; -fx-border-radius: 14; -fx-background-radius: 14; -fx-padding: 16 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.35), 6, 0, 0, 2);">
            <Label text="&#128337; S&#7855;p di&#7877;n ra" style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
            <Label fx:id="aucStatOpen" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #d97706;"/>
        </VBox>
        <!-- FINISHED -->
        <VBox HBox.hgrow="ALWAYS" spacing="4" alignment="CENTER_LEFT"
              style="-fx-background-color: #0d1a12; -fx-border-color: #1a3326; -fx-border-radius: 14; -fx-background-radius: 14; -fx-padding: 16 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.35), 6, 0, 0, 2);">
            <Label text="&#9711; K&#7871;t th&#250;c" style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
            <Label fx:id="aucStatFinished" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>
        </VBox>
        <!-- PAID -->
        <VBox HBox.hgrow="ALWAYS" spacing="4" alignment="CENTER_LEFT"
              style="-fx-background-color: #0d1a12; -fx-border-color: #1a3326; -fx-border-radius: 14; -fx-background-radius: 14; -fx-padding: 16 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.35), 6, 0, 0, 2);">
            <Label text="&#10003; &#272;&#227; thanh to&#225;n" style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
            <Label fx:id="aucStatPaid" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #059669;"/>
        </VBox>
        <!-- CANCELED -->
        <VBox HBox.hgrow="ALWAYS" spacing="4" alignment="CENTER_LEFT"
              style="-fx-background-color: #0d1a12; -fx-border-color: #1a3326; -fx-border-radius: 14; -fx-background-radius: 14; -fx-padding: 16 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.35), 6, 0, 0, 2);">
            <Label text="&#10005; &#272;&#227; h&#7911;y" style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
            <Label fx:id="aucStatCanceled" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #dc2626;"/>
        </VBox>
    </HBox>

    <!-- TABLE CARD -->
    <VBox styleClass="section-card" VBox.vgrow="ALWAYS" spacing="16">
        <HBox alignment="CENTER_LEFT">
            <Label text="Danh s&#225;ch t&#7845;t c&#7843; phi&#234;n &#273;&#7845;u gi&#225;"
                   style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
        </HBox>

        <TableView fx:id="tableAuctions" styleClass="data-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colAucProduct" text="S&#7843;n ph&#7849;m" prefWidth="220"/>
                <TableColumn fx:id="colAucPrice" text="Gi&#225; hi&#7879;n t&#7841;i" prefWidth="110"/>
                <TableColumn fx:id="colAucViews" text="L&#432;&#7907;t xem" prefWidth="70"/>
                <TableColumn fx:id="colAucBids" text="Lượt đặt giá" prefWidth="90"/>
                <TableColumn fx:id="colAucWinner" text="Người thắng" prefWidth="110"/>
                <TableColumn fx:id="colAucSeller" text="Ng&#432;&#7901;i t&#7841;o" prefWidth="110"/>
                <TableColumn fx:id="colAucEnd" text="K&#7871;t th&#250;c" prefWidth="90"/>
                <TableColumn fx:id="colAucStatus" text="Tr&#7841;ng th&#225;i" prefWidth="90"/>
                <TableColumn fx:id="colAucAction" text="Thao t&#225;c" prefWidth="240" minWidth="230" sortable="false"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>

        <!-- PAGINATION ROW -->
        <HBox alignment="CENTER" spacing="12" style="-fx-padding: 8 0 4 0;">
            <Button fx:id="aucBtnFirst" text="&#171;" onAction="#aucGoFirstPage"
                    style="-fx-background-color: #0f2218; -fx-text-fill: #5a9e7a; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 6 12; -fx-font-weight: bold;"/>
            <Button fx:id="aucBtnPrev" text="&#8249;" onAction="#aucGoPrevPage"
                    style="-fx-background-color: #0f2218; -fx-text-fill: #5a9e7a; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 6 12; -fx-font-size: 16; -fx-font-weight: bold;"/>

            <HBox fx:id="aucPageButtonBox" spacing="6" alignment="CENTER"/>

            <Button fx:id="aucBtnNext" text="&#8250;" onAction="#aucGoNextPage"
                    style="-fx-background-color: #0f2218; -fx-text-fill: #5a9e7a; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 6 12; -fx-font-size: 16; -fx-font-weight: bold;"/>
            <Button fx:id="aucBtnLast" text="&#187;" onAction="#aucGoLastPage"
                    style="-fx-background-color: #0f2218; -fx-text-fill: #5a9e7a; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 6 12; -fx-font-weight: bold;"/>

            <Label fx:id="aucLblPageInfo" text="Trang 1 / 1"
                   style="-fx-text-fill: #4d8c6a; -fx-font-size: 12px; -fx-padding: 0 0 0 8;"/>
        </HBox>
    </VBox>
</VBox>
