<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane fx:id="rootPane" prefHeight="700.0" prefWidth="1200.0"
           xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.auction.client.controller.MainController" stylesheets="@css/styles.css">

    <BorderPane>

    <!-- ══════════════════════ SIDEBAR ══════════════════════ -->
    <left>
        <VBox prefWidth="260" styleClass="sidebar">
            <!-- Logo -->
            <HBox alignment="CENTER_LEFT" spacing="10"
                  style="-fx-padding: 18 20 18 20; -fx-border-color: #1a3326; -fx-border-width: 0 0 1 0;">
                <Label style="-fx-background-color: #00a854; -fx-background-radius: 8; -fx-text-fill: #020d06; -fx-alignment: center; -fx-pref-width: 32; -fx-pref-height: 32; -fx-font-size: 16;" text="🔨"/>
                <Label text="UET Auction" style="-fx-font-weight: bold; -fx-font-size: 17px; -fx-text-fill: #00e676;"/>
            </HBox>

            <!-- Nav Items -->
            <VBox spacing="2" VBox.vgrow="ALWAYS" style="-fx-padding: 20 12 8 12;">
                <!-- Menu chính -->
                <Label text="MENU CHÍNH" styleClass="nav-label" style="-fx-padding: 0 8 6 8;"/>

                <Button fx:id="navList" text="   🔲  Danh sách đấu giá" prefWidth="236" prefHeight="38"
                        styleClass="nav-button-active" onAction="#showPageList"/>

                <Button fx:id="navDetail" text="   🔍  Chi tiết sản phẩm" prefWidth="236" prefHeight="38"
                        styleClass="nav-button" onAction="#showPageDetail" visible="false" managed="false"/>

                <Separator style="-fx-padding: 10 0 10 0; -fx-background-color: #1a3326;"/>

                <!-- Người bán -->
                <VBox fx:id="sellerNav" spacing="2">
                    <Label text="NGƯỜI BÁN" styleClass="nav-label" style="-fx-padding: 0 8 6 8;"/>
                    <Button fx:id="navManage" text="   📦  Quản lý sản phẩm" prefWidth="236" prefHeight="38"
                            styleClass="nav-button" onAction="#showPageManage"/>
                </VBox>

                <Separator style="-fx-padding: 10 0 10 0; -fx-background-color: #1a3326;"/>

                <!-- Admin (ẩn nếu không phải ADMIN) -->
                <VBox fx:id="adminNav" spacing="2" visible="false" managed="false">
                    <Label text="QUẢN TRỊ HỆ THỐNG" styleClass="nav-label" style="-fx-padding: 0 8 6 8;"/>
                    <Button fx:id="navAdminUsers" text="   👥  Quản lý người dùng" prefWidth="236" prefHeight="38"
                            styleClass="nav-button" onAction="#showPageAdminUsers"/>
                    <Button fx:id="navAdminAuctions" text="   ⚙  Quản lý đấu giá" prefWidth="236" prefHeight="38"
                            styleClass="nav-button" onAction="#showPageAdminAuctions"/>
                    <Separator style="-fx-padding: 10 0 10 0; -fx-background-color: #1a3326;"/>
                </VBox>

                <!-- Cá nhân -->
                <Label text="CÁ NHÂN" styleClass="nav-label" style="-fx-padding: 0 8 6 8;"/>
                <Button fx:id="navAccount" text="   👤  Tài khoản của tôi" prefWidth="236" prefHeight="38"
                        styleClass="nav-button" onAction="#showPageAccount"/>
                <Button fx:id="navPayment" text="   💳  Thanh toán" prefWidth="236" prefHeight="38"
                        styleClass="nav-button" onAction="#showPagePayment"/>

                <Region VBox.vgrow="ALWAYS"/>
            </VBox>

            <!-- Logout -->
            <VBox style="-fx-padding: 12; -fx-border-color: #1a3326; -fx-border-width: 1 0 0 0;">
                <Button text="   🚪  Đăng xuất" prefWidth="236" prefHeight="38"
                        styleClass="nav-logout" onAction="#handleLogout"/>
            </VBox>
        </VBox>
    </left>

    <!-- ══════════════════════ CENTER ══════════════════════ -->
    <center>
        <VBox style="-fx-background-color: #080f0a;">
            <!-- Header Bar -->
            <HBox alignment="CENTER_LEFT" prefHeight="60" styleClass="header-bar" spacing="16">
                <!-- Back Button -->
                <Button fx:id="btnBack" text="← Quay lại" onAction="#handleBack"
                        visible="false" managed="false"
                        style="-fx-background-color: #0d1a12; -fx-text-fill: #00c87a; -fx-font-weight: bold;
                               -fx-font-size: 13; -fx-padding: 7 16; -fx-border-color: #1a3326;
                               -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 4, 0, 0, 1);"/>

                <Label fx:id="headerTitle" text="Danh sách đấu giá" styleClass="page-title"/>
                <Separator orientation="VERTICAL" style="-fx-padding: 0 0 0 0; -fx-background-color: #1a3326;">
                    <HBox.margin><Insets top="15" bottom="15"/></HBox.margin>
                </Separator>
                <Label fx:id="headerGreeting" text="Xin chào!" styleClass="header-greeting"/>
                <Region HBox.hgrow="ALWAYS"/>

                <!-- Clock -->
                <Label fx:id="lblClock" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #4d8c6a;"/>

                <!-- Icons -->
                <Button fx:id="btnThemeToggle" text="🌙" onAction="#toggleTheme" styleClass="icon-btn"
                        style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 16; -fx-padding: 4 8; -fx-border-radius: 50%;" />

                <StackPane>
                    <Button text="🔔" onAction="#toggleNotifications" styleClass="icon-btn"
                            style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 16; -fx-padding: 4 8; -fx-border-radius: 50%;" />
                    <Label fx:id="notifBadge" text="2" styleClass="notif-badge" mouseTransparent="true"
                           StackPane.alignment="TOP_RIGHT" style="-fx-translate-x: -2; -fx-translate-y: 2;" />
                </StackPane>

                <Label fx:id="headerBalance" text="💰 0 VNĐ" styleClass="balance-chip"/>
                <HBox alignment="CENTER" spacing="8" styleClass="user-chip">
                    <Label fx:id="headerAvatar" text="?" styleClass="avatar-label"/>
                    <Label fx:id="headerUsername" text="Khách" style="-fx-font-size: 13; -fx-font-weight: 500; -fx-text-fill: #c6f6e0;"/>
                </HBox>
            </HBox>

            <!-- Content Area -->
            <StackPane fx:id="contentStack" VBox.vgrow="ALWAYS" style="-fx-background-color: #080f0a;">
                <!-- Pages will be loaded programmatically -->
            </StackPane>
        </VBox>
    </center>
    </BorderPane>

    <!-- Notification Dropdown Overlay -->
    <VBox fx:id="notifDropdown" visible="false" managed="false"
          StackPane.alignment="TOP_RIGHT"
          styleClass="notif-dropdown"
          maxWidth="360" maxHeight="450"
          style="-fx-translate-y: 65; -fx-translate-x: -20;">

        <HBox alignment="CENTER_RIGHT" styleClass="notif-header">
            <Hyperlink text="Đánh dấu đã đọc" onAction="#markAllNotifsRead" style="-fx-text-fill: #00c87a; -fx-font-weight: bold;"/>
        </HBox>
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="scroll-pane">
            <VBox fx:id="notifList" spacing="0" style="-fx-background-color: #0d1a12;">
                <!-- Notifications injected here -->
            </VBox>
        </ScrollPane>
    </VBox>

</StackPane>
