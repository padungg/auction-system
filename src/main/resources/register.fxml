<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.RegisterController">
   <children>
      <HBox prefHeight="720.0" prefWidth="1280.0">
         <children>

            <VBox alignment="CENTER" prefWidth="550.0" style="-fx-background-color: linear-gradient(to bottom right, #1e3a8a, #3b82f6, #06b6d4);" HBox.hgrow="ALWAYS">
               <children>
                  <ImageView fitHeight="150.0" fitWidth="150.0" pickOnBounds="true" preserveRatio="true" style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 15, 0, 0, 5);">
                     <image>
                        <Image url="@images/gavel-solid.png" />
                     </image>
                     <VBox.margin>
                        <Insets bottom="20.0" />
                     </VBox.margin>
                  </ImageView>
                  <Label text="UET AUCTION" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="48.0" />
                     </font>
                  </Label>
                  <Label text="Nền tảng đấu giá trực tuyến hàng đầu" textFill="#e0f2fe">
                     <font>
                        <Font size="18.0" />
                     </font>
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                  </Label>

                  <Separator maxWidth="80.0" style="-fx-background-color: white; -fx-opacity: 0.5;">
                     <VBox.margin>
                        <Insets top="30.0" />
                     </VBox.margin>
                  </Separator>

                  <Label text="Tham gia cộng đồng để bắt đầu đấu giá" textFill="#bae6fd">
                     <font>
                        <Font size="14.0" />
                     </font>
                     <VBox.margin>
                        <Insets top="20.0" />
                     </VBox.margin>
                  </Label>
               </children>
            </VBox>

            <VBox alignment="CENTER" prefWidth="730.0" style="-fx-background-color: #ffffff;" HBox.hgrow="ALWAYS">
               <children>
                  <VBox maxWidth="450.0" spacing="15.0">
                     <children>

                        <VBox spacing="5.0">
                           <children>
                              <Label text="Tạo tài khoản mới" textFill="#111827">
                                 <font>
                                    <Font name="System Bold" size="36.0" />
                                 </font>
                              </Label>
                              <Label text="Điền thông tin của bạn để gia nhập hệ thống" textFill="#6b7280">
                                 <font>
                                    <Font size="16.0" />
                                 </font>
                              </Label>
                           </children>
                           <VBox.margin>
                              <Insets bottom="5.0" />
                           </VBox.margin>
                        </VBox>

                        <VBox spacing="8.0">
                           <children>
                              <Label text="Họ và tên" textFill="#374151">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="txtFullName" prefHeight="50.0" promptText="Ví dụ: Nguyễn Văn A" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #d1d5db; -fx-background-color: #f9fafb; -fx-padding: 0 15 0 15;">
                                 <font>
                                    <Font size="15.0" />
                                 </font>
                              </TextField>
                           </children>
                        </VBox>

                        <VBox spacing="8.0">
                           <children>
                              <Label text="Tên đăng nhập (Mã SV)" textFill="#374151">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="txtUsername" prefHeight="50.0" promptText="Ví dụ: 2002xxxx" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #d1d5db; -fx-background-color: #f9fafb; -fx-padding: 0 15 0 15;">
                                 <font>
                                    <Font size="15.0" />
                                 </font>
                              </TextField>
                           </children>
                        </VBox>

                        <VBox spacing="8.0">
                           <children>
                              <Label text="Mật khẩu" textFill="#374151">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <PasswordField fx:id="txtPassword" prefHeight="50.0" promptText="Tạo mật khẩu an toàn..." style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #d1d5db; -fx-background-color: #f9fafb; -fx-padding: 0 15 0 15;">
                                 <font>
                                    <Font size="15.0" />
                                 </font>
                              </PasswordField>
                           </children>
                        </VBox>

                        <VBox spacing="8.0">
                           <children>
                              <Label text="Xác nhận mật khẩu" textFill="#374151">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <PasswordField fx:id="txtConfirmPassword" prefHeight="50.0" promptText="Nhập lại mật khẩu..." style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #d1d5db; -fx-background-color: #f9fafb; -fx-padding: 0 15 0 15;">
                                 <font>
                                    <Font size="15.0" />
                                 </font>
                              </PasswordField>
                           </children>
                        </VBox>

                        <Label fx:id="lblError" text="⚠️ Mật khẩu không khớp hoặc thiếu thông tin!" textFill="#ef4444" visible="false">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Label>

                        <Button fx:id="btnRegister" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleRegister" prefHeight="55.0" style="-fx-background-color: #06b6d4; -fx-text-fill: white; -fx-background-radius: 10; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(6, 182, 212, 0.3), 10, 0, 0, 5);" text="ĐĂNG KÝ TÀI KHOẢN">
                           <font>
                              <Font name="System Bold" size="18.0" />
                           </font>
                           <VBox.margin>
                              <Insets top="5.0" />
                           </VBox.margin>
                        </Button>

                        <HBox alignment="CENTER" spacing="8.0">
                           <children>
                              <Label text="Đã có tài khoản?" textFill="#6b7280">
                                 <font>
                                    <Font size="15.0" />
                                 </font>
                              </Label>
                              <Label fx:id="lblLogin" onMouseClicked="#switchToLogin" style="-fx-cursor: hand;" text="Đăng nhập tại đây" textFill="#2563eb">
                                 <font>
                                    <Font name="System Bold" size="15.0" />
                                 </font>
                              </Label>
                           </children>
                           <VBox.margin>
                              <Insets top="10.0" />
                           </VBox.margin>
                        </HBox>

                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</StackPane>