<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.server.HelloController">
   <children>
      <Button fx:id="loginButton" layoutX="247.0" layoutY="234.0" mnemonicParsing="false" onAction="#handleLogin" text="Đăng nhập" />
      <PasswordField fx:id="passwordButton" layoutX="210.0" layoutY="187.0" onAction="#handlePassword" promptText="Mật khẩu" />
      <TextField fx:id="usernameButton" layoutX="210.0" layoutY="145.0" onAction="#handleUsername" promptText="Tài khoản" />
      <Label fx:id="textLogin" layoutX="194.0" layoutY="113.0" text="HỆ THỐNG ĐẤU GIÁ TRỰC TUYẾN" />
   </children>
</AnchorPane>
