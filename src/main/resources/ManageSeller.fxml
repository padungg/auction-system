<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.lang.String?>
<?import javafx.collections.FXCollections?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.client.controller.ManageSellerController"
            stylesheets="@css/ManageSeller.css">
    <VBox spacing="20" style="-fx-padding: 24;">

    <!-- Breadcrumb -->
    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="breadcrumb">
        <Label text="Trang chủ" style="-fx-text-fill: #64748b;"/>
        <Label text="›" styleClass="breadcrumb-sep"/>
        <Label text="Người bán" style="-fx-text-fill: #64748b;"/>
        <Label text="›" styleClass="breadcrumb-sep"/>
        <Label text="Quản lý sản phẩm" style="-fx-text-fill: #1e293b; -fx-font-weight: bold;"/>
    </HBox>

    <!-- Table -->
    <VBox VBox.vgrow="ALWAYS" spacing="10">
        <TableView fx:id="tableProducts" styleClass="data-table" VBox.vgrow="ALWAYS" minHeight="300" prefHeight="400">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                <TableColumn fx:id="colName" text="Tên sản phẩm" prefWidth="200"/>
                <TableColumn fx:id="colType" text="Loại" prefWidth="120"/>
                <TableColumn fx:id="colStartPrice" text="Giá khởi điểm" prefWidth="120"/>
                <TableColumn fx:id="colCurrentPrice" text="Giá hiện tại" prefWidth="120"/>
                <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="100"/>
                <TableColumn fx:id="colAction" text="Thao tác" prefWidth="180"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>

    <!-- Create Form -->
    <VBox styleClass="section-card" spacing="16">
        <Label text="➕ Tạo phiên đấu giá mới" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
        
        <GridPane hgap="20" vgap="16">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
            </columnConstraints>
            
            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label text="Tên sản phẩm *" styleClass="form-label"/>
                <TextField fx:id="txtName" promptText="Nhập tên sản phẩm..." styleClass="form-input"/>
            </VBox>
            
            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label text="Loại sản phẩm *" styleClass="form-label"/>
                <ComboBox fx:id="cbType" promptText="-- Chọn loại --" styleClass="form-select" maxWidth="Infinity">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="ELECTRONICS"/>
                            <String fx:value="ART"/>
                            <String fx:value="VEHICLE"/>
                        </FXCollections>
                    </items>
                </ComboBox>
            </VBox>
            
            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                <Label text="Giá khởi điểm (VNĐ) *" styleClass="form-label"/>
                <TextField fx:id="txtPrice" promptText="Ví dụ: 1000000" styleClass="form-input"/>
            </VBox>
            
            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                <Label text="Bước giá tối thiểu (VNĐ) *" styleClass="form-label"/>
                <TextField fx:id="txtStepPrice" promptText="Ví dụ: 50000" styleClass="form-input"/>
            </VBox>
            
            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="2">
                <Label text="Thời hạn đấu giá (giờ) *" styleClass="form-label"/>
                <TextField fx:id="txtDurationHours" promptText="Ví dụ: 2" styleClass="form-input"/>
            </VBox>
            
            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="2">
                <Label text="Tình trạng" styleClass="form-label"/>
                <ComboBox fx:id="cbCondition" promptText="-- Tình trạng --" styleClass="form-select" maxWidth="Infinity">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Mới"/>
                            <String fx:value="Như mới"/>
                            <String fx:value="Đã qua sử dụng"/>
                        </FXCollections>
                    </items>
                </ComboBox>
            </VBox>

            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="2">
                <Label text="Thời gian bắt đầu (Không bắt buộc)" styleClass="form-label"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <DatePicker fx:id="dpStartDate" promptText="Chọn ngày" prefWidth="150" minWidth="150" styleClass="form-input"/>
                    <ComboBox fx:id="cbStartHour" promptText="Giờ" prefWidth="95" minWidth="95" styleClass="time-combo"/>
                    <Label text="giờ" style="-fx-text-fill: #475569;"/>
                    <Label text=":" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
                    <ComboBox fx:id="cbStartMinute" promptText="Phút" prefWidth="95" minWidth="95" styleClass="time-combo"/>
                    <Label text="phút" style="-fx-text-fill: #475569;"/>
                </HBox>
            </VBox>

            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="4" GridPane.columnSpan="2">
                <Label text="Hình ảnh sản phẩm" styleClass="form-label"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Button fx:id="btnChooseImage" text="Chọn ảnh..." onAction="#handleChooseImage" styleClass="btn, btn-ghost" style="-fx-border-color: #cbd5e1; -fx-text-fill: #475569;"/>
                    <Label fx:id="lblImageStatus" text="Chưa chọn ảnh" style="-fx-text-fill: #64748b; -fx-font-size: 13;"/>
                </HBox>
            </VBox>
            
            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="5" GridPane.columnSpan="2">
                <Label text="Mô tả sản phẩm" styleClass="form-label"/>
                <TextArea fx:id="txtDesc" promptText="Mô tả chi tiết sản phẩm..." prefRowCount="3" styleClass="form-textarea"/>
            </VBox>
        </GridPane>
        
        <!-- Dynamic fields based on type -->
        <VBox fx:id="paneElectronics" style="-fx-padding: 16; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;" spacing="16" visible="false" managed="false">
            <Label text="💻 THÔNG TIN ELECTRONICS" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>
            <GridPane hgap="20" vgap="16">
                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                </columnConstraints>
                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Hãng sản xuất (brand)" styleClass="form-label"/>
                    <TextField fx:id="txtElecBrand" promptText="Apple, Samsung..." styleClass="form-input"/>
                </VBox>
                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Bảo hành (tháng)" styleClass="form-label"/>
                    <TextField fx:id="txtElecWarranty" promptText="Số tháng" styleClass="form-input"/>
                </VBox>
            </GridPane>
        </VBox>

        <VBox fx:id="paneArt" style="-fx-padding: 16; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;" spacing="16" visible="false" managed="false">
            <Label text="🎨 THÔNG TIN NGHỆ THUẬT" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>
            <GridPane hgap="20" vgap="16">
                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                </columnConstraints>
                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Nghệ sĩ / Tác giả" styleClass="form-label"/>
                    <TextField fx:id="txtArtArtist" promptText="Tên nghệ sĩ" styleClass="form-input"/>
                </VBox>
                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Chất liệu" styleClass="form-label"/>
                    <TextField fx:id="txtArtMaterial" promptText="Sơn dầu, sơn mài..." styleClass="form-input"/>
                </VBox>
                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label text="Năm sáng tác" styleClass="form-label"/>
                    <TextField fx:id="txtArtYear" promptText="2020" styleClass="form-input"/>
                </VBox>
            </GridPane>
        </VBox>

        <VBox fx:id="paneVehicle" style="-fx-padding: 16; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;" spacing="16" visible="false" managed="false">
            <Label text="🚗 THÔNG TIN PHƯƠNG TIỆN" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>
            <GridPane hgap="20" vgap="16">
                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                </columnConstraints>
                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Hãng xe" styleClass="form-label"/>
                    <TextField fx:id="txtVehBrand" promptText="Honda, Toyota..." styleClass="form-input"/>
                </VBox>
                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Dòng xe" styleClass="form-label"/>
                    <TextField fx:id="txtVehModel" promptText="Air Blade, Vios..." styleClass="form-input"/>
                </VBox>
                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label text="Năm sản xuất" styleClass="form-label"/>
                    <TextField fx:id="txtVehYear" promptText="2022" styleClass="form-input"/>
                </VBox>
                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label text="Số km đã đi" styleClass="form-label"/>
                    <TextField fx:id="txtVehKm" promptText="12000" styleClass="form-input"/>
                </VBox>
            </GridPane>
        </VBox>
        
        <HBox alignment="CENTER_RIGHT" spacing="12" style="-fx-padding: 16 0 0 0; -fx-border-color: #f1f5f9; -fx-border-width: 1 0 0 0;">
            <Label fx:id="lblSuccess" text="🎉 Tạo phiên đấu giá thành công!" visible="false" managed="false" style="-fx-background-color: #22c55e; -fx-text-fill: white; -fx-padding: 8 16; -fx-background-radius: 6; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Xóa trắng" onAction="#handleClear" styleClass="btn, btn-ghost" style="-fx-border-color: #cbd5e1; -fx-text-fill: #475569;"/>
            <Button fx:id="btnCreateSubmit" text="🔨 Tạo phiên đấu giá" onAction="#handleCreate" styleClass="btn, btn-primary"/>
        </HBox>
    </VBox>
    </VBox>
</ScrollPane>

